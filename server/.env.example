# Porta da API
PORT=4000

# Provedor de IA: "heuristic" (padrão, sem dependências) ou "ollama" (modelo open source local)
AI_PROVIDER=heuristic

# Quem decide as mudanças nos anúncios já publicados:
# "manual" (padrão) = a IA só propõe; o dono aprova na Central de comando.
# "automatico" = a IA reotimiza o SEO sozinha. Publicar um produto num
# marketplace novo exige aprovação do dono nos dois modos.
APPROVAL_MODE=manual

# Usados apenas quando AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frequência do ciclo automático de reotimização de SEO (em horas)
OPTIMIZATION_INTERVAL_HOURS=6

# Tempo mínimo entre duas otimizações do mesmo anúncio (em horas)
OPTIMIZATION_COOLDOWN_HOURS=24

# Cotação USD->BRL usada para converter custos de fornecedores estrangeiros.
# NÃO é uma cotação ao vivo — atualize manualmente (aqui ou em Configurações).
USD_TO_BRL_RATE=5.30

# Estimativa grosseira da carga tributária de importação comercial em volume
# (II + IPI + PIS/COFINS + ICMS sobre custo+frete). Não é um valor oficial —
# confirme com um despachante aduaneiro/contador antes de importar.
IMPORT_TAX_PERCENT=60

# ICMS de referência para remessas individuais (regime de dropshipping —
# diferente do import comercial acima). Varia por estado; confira em
# simuladores como o tributado.net antes de usar em produção real.
REMESSA_ICMS_PERCENT=17

# Opcional. Por padrão o agente de tendências/SEO já busca dados reais
# direto do Google Trends, sem custo e sem chave (com fallback automático
# para um dataset curado se o Google limitar a requisição). Só preencha
# SERPAPI_KEY (conta em https://serpapi.com, paga além do plano gratuito)
# se você quiser usar essa alternativa mais estável em vez do acesso direto
# e gratuito. Pode também ser definida pela tela de Configurações do app
# (tem prioridade sobre esta variável).
SERPAPI_KEY=
