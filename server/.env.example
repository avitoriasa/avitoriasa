# Porta da API
PORT=4000

# Provedor de IA: "heuristic" (padrão, sem dependências) ou "ollama" (modelo open source local)
AI_PROVIDER=heuristic

# Usados apenas quando AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frequência do ciclo automático de reotimização de SEO (em horas)
OPTIMIZATION_INTERVAL_HOURS=6

# Tempo mínimo entre duas otimizações do mesmo anúncio (em horas)
OPTIMIZATION_COOLDOWN_HOURS=24

# Cotação USD->BRL usada para converter custos de fornecedores estrangeiros.
# NÃO é uma cotação ao vivo — atualize manualmente (aqui ou em Configurações).
USD_TO_BRL_RATE=5.30
